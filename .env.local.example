# Copy this file to .env.local for local development.
# In production (Vercel), set these as Environment Variables in the project settings instead —
# never commit your real keys to GitHub.

CLOUDCONVERT_API_KEY=your_cloudconvert_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Backend idempotency store for paid conversions (lib/paymentIdempotency.js)
# — stops one successful payment from being able to trigger more than one
# CloudConvert job. In production this MUST be set or paid conversions will
# fail closed. Easiest setup: in your Vercel project, go to Storage -> add
# a "Redis" integration from the Marketplace (Upstash-backed) — it injects
# these two vars automatically. Without a Vercel project, sign up directly
# at upstash.com and use UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN
# instead (either naming is accepted).
KV_REST_API_URL=your_upstash_redis_rest_url_here
KV_REST_API_TOKEN=your_upstash_redis_rest_token_here

# "Upload from Google Drive / Dropbox" buttons (components/cloudUpload/) —
# each provider's button only appears once its own vars below are set, so
# these are entirely optional; leave them unset to keep those buttons
# hidden everywhere. Both are NEXT_PUBLIC_ (used client-side in the
# visitor's own browser to let THEM pick a file from THEIR OWN account) —
# unrelated to GOOGLE_SERVICE_ACCOUNT_* above, which authenticates as your
# own service account for the separate Google Drive Convert tool.
#
# Google Drive: in Google Cloud Console, create/select a project, enable
# the "Google Picker API" and "Google Drive API", then create an OAuth 2.0
# Client ID (Application type: Web application) with your site's real
# origin(s) under "Authorized JavaScript origins" (e.g.
# https://yourdomain.com and http://localhost:3000 for local dev), and an
# API key (restrict it to the Picker API for safety).
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=your_google_api_key_here
NEXT_PUBLIC_GOOGLE_PICKER_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
#
# Dropbox: in the Dropbox App Console (dropbox.com/developers/apps), create
# an app, add your site's domain(s) under "Chooser / Saver / Embedder
# domains", and copy the app key.
NEXT_PUBLIC_DROPBOX_APP_KEY=your_dropbox_app_key_here
